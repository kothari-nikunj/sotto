# Hermes/Sotto secrets. Copy to ~/.hermes/.env
# (This file carries the variables most installs touch; the FULL reference — every SOTTO_* var,
# with defaults — is RAILWAY.md § Environment variables.)
# This IS Hermes' native model key (Hermes manages providers/keys) — not a separate Sotto store.
# The brief needs a 1M-CONTEXT model; Gemini 3.7 Flash recommended (auto-falls back to
# gemini-3-flash-preview on quota/5xx — cheaper, separate rate-limit bucket). Any 1M-context GEMINI
# model works: the brief pipeline posts to Gemini's REST API directly, so this key is the one it
# needs. The CHAT layer is Hermes' and switches to Anthropic/OpenAI/Kimi/DeepSeek freely (docs/MODELS.md).
GOOGLE_AI_API_KEY=<your-gemini-key>           # 1M-ctx model for the brief (+ chat, if you set it as the model)
# Web research picks its provider by which key is present — no selector variable, ever:
#   web_search  Exa → Gemini grounding    deep_research  Parallel → Exa → Gemini grounding
#   fetch_url (read a sent link)  Exa → Gemini url_context → Browser Use Cloud (last: real browser, real credits)
# EXA_API_KEY=<exa-key>                       # better search than grounding when set (exa.ai)
# PARALLEL_API_KEY=<parallel-key>             # deep research for attendee/company digs (parallel.ai)
# BROWSER_USE_API_KEY=<browser-use-key>       # hosted browser for JS-heavy link reads (cloud.browser-use.com) — read-only, never your logins
# --- Your channel: WhatsApp is the DEFAULT, not a requirement (see CHANNELS.md) ---
# SOTTO_CRON_DELIVER=whatsapp        # THE channel choice: where every scheduled thing is delivered
                                     #   (briefs, digest, pulse, proactive watcher, your own routines).
                                     #   `telegram` / `local` / the name `hermes gateway setup` gave
                                     #   BlueBubbles all work; no per-job override, by design.
# WHATSAPP_ENABLED=false             # skip the boot-time QR pairing entirely when you deliver elsewhere
# Your channel's OWN variables are Hermes' names, not Sotto's — anything you set starting with
# TELEGRAM_ / BLUEBUBBLES_ / SIGNAL_ / DISCORD_ / SLACK_ is forwarded into this file on boot.
# SOTTO_TOOL_PROGRESS=off            # what streams into chat while Sotto works: off (default — the
                                     #   typing indicator covers the wait, first message = the result),
                                     #   new (narration + one tool bubble), all/verbose (debugging)
# SOTTO_REACTIONS=1                  # Telegram tapbacks on your messages: 👀 working · ✅ replied ·
                                     #   ❌ error (0 disables; Telegram-only — no WhatsApp bot reactions)
SOTTO_DATA=/data                              # exhaust volume path (passed to the skill scripts)
BRIDGE_TOKEN=<long-random-secret>             # THE shared bearer for the Mac Bridge (pairing link
                                              #   carries it; `openssl rand -hex 24`). Wake-push
                                              #   uses it too.
# SOTTO_TRIGGER_TOKEN=<separate-bearer>       # ONLY to give /sotto/trigger its own bearer distinct
                                              #   from BRIDGE_TOKEN; almost nobody needs this
# SOTTO_TIMEZONE=America/Los_Angeles          # IANA zone. Cloud auto-detects it in the wizard;
                                              #   LOCAL installs must set it or briefs compute
                                              #   "today" in UTC
# SOTTO_PROACTIVE=1                           # 0 = skip registering the */15 proactive-watcher cron
# SOTTO_USER_EMAIL=you@example.com   # your own email address; used to exclude yourself from attendee
                                     # research and post-meeting taps
# No Claude key (no polish stage). No Google/Granola OAuth secrets here — Hermes owns those.
# Defaults matter: only credentials and real user choices live here. Tuning (tap windows, valve
# rates, escalation/freshness thresholds, research caps) is named constants in code, not env vars.
# --- Real-time events (Phase 2) — all optional, defaults shown ---
# SOTTO_EVENTS=1                  # kill switch for the Bridge event watcher (0 = no /bridge/events pushes)
# SOTTO_EVENTS_TICK_SECS=3        # Bridge-side watcher tick interval (seconds)
# SOTTO_EMAIL_POLL_SECS=90        # cloud-side Gmail poll interval feeding the triage funnel (0 = disable)
# SOTTO_TRIAGE_MODEL=gemini-3.5-flash-lite   # cheap Tier-1 triage model
# SOTTO_EVENT_COOLDOWN_MIN=20     # max one agent nudge per thread per this many minutes
# SOTTO_DIGEST_MIN=8              # queued signals from known senders since the last DELIVERED brief/digest
                                  #   needed before the midday digest fires (else it stays silent)
# SOTTO_DIGEST=1                  # 0 = skip the 12:30 sotto-midday-digest cron entirely
# --- Nudge cadence (who gets through, how often) — see docs/HOW-SOTTO-DECIDES.md ---
# SOTTO_NUDGE_BUDGET=4            # cross-thread interrupt nudges per LOCAL day (taps are exempt)
# SOTTO_TAP_MAX_PER_DAY=3         # post-meeting taps per LOCAL day — their own cap, not the budget above
# SOTTO_QUIET_START=21            # no nudges from this hour...
# SOTTO_QUIET_END=7               # ...until this one (VIP missed calls are the one carve-out)
# SOTTO_USER_NAME=<Your Name>     # group name-mention detection; unset = groups never nudge
# SOTTO_CHASE_AFTER_DAYS=3        # silent days before something you're OWED becomes chase-eligible
                                  #   (and the gap between chases; max 2, then it's your call)
# SOTTO_BIRTHDAY_LEAD_DAYS=3      # days ahead of a birthday the gift-idea nudge fires (0 = day-of only)
# --- Release valve (held nudges get out when the hold lifts) ---
# SOTTO_VALVE=1                   # 0 disables promotion entirely
# --- Calendar cache + post-meeting tap ---
# SOTTO_CALENDAR_REFRESH_SECS=900 # today's-calendar refresh (0 disables the in-meeting hold + taps)
# SOTTO_MEETING_TAP=1             # 0 disables the post-meeting follow-up tap
# SOTTO_CALENDAR_NUDGES=1         # 0 disables decline/last-minute-invite/move/cancel nudges
# --- Spawned skill runs (briefs, nudges, event agents) ---
# SOTTO_SPAWN_TOOLSETS=sotto-local,google-workspace
                                  # scope the spawned one-shot to these Hermes toolset ids. Unset =
                                  #   today's behavior (the runner picks): toolset ids vary by
                                  #   install and a wrong guess breaks EVERY brief, so there is no
                                  #   safe default — check `hermes tools --summary` first. Ignored
                                  #   unless the runner is hermes (see SOTTO_RUN_SKILL).
