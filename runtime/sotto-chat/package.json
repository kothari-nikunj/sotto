{
  "name": "@sotto/chat-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0 <27"
  },
  "scripts": {
    "start": "node dist/bootstrap/main.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "benchmark:latency": "node --import tsx scripts/benchmark-latency.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "eval:conversation": "node --import tsx evals/conversation.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.94",
    "@ai-sdk/google": "4.0.109",
    "@ai-sdk/openai": "4.0.106",
    "@ai-sdk/openai-compatible": "3.0.82",
    "@chat-adapter/telegram": "4.43.0",
    "@grpc/grpc-js": "1.14.6",
    "@mastra/core": "1.81.0",
    "@mastra/libsql": "1.28.0",
    "@mastra/memory": "1.40.0",
    "@photon-ai/advanced-imessage": "2.4.0",
    "@photon-ai/chat-adapter-imessage": "3.2.0",
    "@spectrum-ts/core": "12.14.0",
    "@spectrum-ts/imessage": "12.14.0",
    "ai": "7.0.159",
    "chat": "4.43.0",
    "nice-grpc": "2.1.18",
    "nice-grpc-common": "2.0.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "overrides": {
    "@photon-ai/chat-adapter-imessage": {
      "@spectrum-ts/core": "$@spectrum-ts/core",
      "@spectrum-ts/imessage": "$@spectrum-ts/imessage"
    }
  }
}
