# Credential-free Linux verification; deliberately separate from the production image.
# Resolved from the official node:22-bookworm-slim manifest on 2026-09-30.
FROM node:22-bookworm-slim@sha256:43ac6c60b8f89723f746e8a92ce91abd5017e627ce1ddfe4238355d3a30b772c
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv util-linux && rm -rf /var/lib/apt/lists/*
WORKDIR /app/runtime/sotto-chat
ENV MASTRA_TELEMETRY_DISABLED=1
ENV PYTHON=/opt/sotto-test-python/bin/python
COPY requirements.txt /tmp/requirements.txt
RUN <<'SH'
set -eu
python3 -m venv /opt/sotto-test-python
python3 - <<'PY'
from pathlib import Path
lines = Path('/tmp/requirements.txt').read_text().splitlines(keepends=True)
blocks = []
for name, version in (('pillow', '12.3.0'), ('pyyaml', '6.0.1')):
    starts = [i for i, line in enumerate(lines) if line.startswith(f'{name}==')]
    if len(starts) != 1 or not lines[starts[0]].startswith(f'{name}=={version} '):
        raise SystemExit(f'locked {name} requirement is missing or changed')
    start = starts[0]
    end = next((i for i in range(start + 1, len(lines))
                if lines[i] and not lines[i][0].isspace()), len(lines))
    blocks.extend(lines[start:end])
Path('/tmp/visual-locked.txt').write_text(''.join(blocks))
PY
/opt/sotto-test-python/bin/python -m pip install --no-cache-dir --require-hashes --only-binary=:all: -r /tmp/visual-locked.txt
rm /tmp/requirements.txt /tmp/visual-locked.txt
SH
COPY runtime/sotto-chat/package.json runtime/sotto-chat/package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY runtime/sotto-chat/ ./
COPY adapters/sotto/ /app/adapters/sotto/
COPY runtime/trigger-receiver/ /app/runtime/trigger-receiver/
COPY sotto-chief-of-staff/ /app/sotto-chief-of-staff/
RUN npm run typecheck && npm run build
CMD ["npm", "test"]
